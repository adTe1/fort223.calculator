Grammar

    0 $accept: program "end of file"

    1 program: body "end" subprograms

    2 body: declarations statements

    3 declarations: declarations type vars
    4             | declarations "common" cblock_list
    5             | declarations "data" vals
    6             | ε

    7 type: "int"
    8     | "real"
    9     | "complex"
   10     | "logical"
   11     | "char"

   12 vars: vars "," undef_variable
   13     | undef_variable

   14 undef_variable: "id" "(" dims ")"
   15               | "id"

   16 dims: dims "," dim
   17     | dim

   18 dim: "iconst"
   19    | "id"

   20 cblock_list: cblock_list cblock
   21            | cblock

   22 cblock: "/" "id" "/" id_list

   23 id_list: id_list "," "id"
   24        | "id"

   25 vals: vals "," "id" value_list
   26     | "id" value_list

   27 value_list: "/" values "/"

   28 values: values "," value
   29       | value

   30 value: sign constant
   31      | "string"

   32 sign: "+ or -"
   33     | ε

   34 constant: simple_constant
   35         | complex_constant

   36 simple_constant: "iconst"
   37                | "rconst"
   38                | "lconst"
   39                | "cconst"

   40 complex_constant: "[" "rconst" ":" sign "rconst" "]"

   41 statements: statements labeled_statement
   42           | labeled_statement

   43 labeled_statement: label statement
   44                  | statement

   45 label: "iconst"

   46 statement: simple_statement
   47          | compound_statement

   48 simple_statement: assignment
   49                 | goto_statement
   50                 | if_statement
   51                 | subroutine_call
   52                 | io_statement
   53                 | "continue"
   54                 | "return"
   55                 | "stop"

   56 assignment: variable "=" expression
   57           | variable "=" "string"

   58 variable: "id" "(" expressions ")"
   59         | "id"

   60 expressions: expressions "," expression
   61            | expression

   62 expression: expression ".OR." expression
   63           | expression ".AND." expression
   64           | expression ".GT. or.GE. or .LT. or .LE. or .EQ. or .NE." expression
   65           | expression "+ or -" expression
   66           | expression "*" expression
   67           | expression "/" expression
   68           | expression "**" expression
   69           | ".NOT." expression
   70           | "+ or -" expression
   71           | variable
   72           | simple_constant
   73           | "(" expression ")"
   74           | "[" expression ":" expression "]"
   75           | "length" "(" expression ")"

   76 goto_statement: "goto" label
   77               | "goto" "id" "," "(" labels ")"

   78 labels: labels "," label
   79       | label

   80 if_statement: "if" "(" expression ")" label "," label "," label
   81             | "if" "(" expression ")" simple_statement

   82 subroutine_call: "call" variable

   83 io_statement: "read" read_list
   84             | "write" write_list

   85 read_list: read_list "," read_item
   86          | read_item

   87 read_item: variable
   88          | "(" read_list "," "id" "=" iter_space ")"

   89 iter_space: expression "," expression step

   90 step: "," expression
   91     | ε

   92 write_list: write_list "," write_item
   93           | write_item

   94 write_item: expression
   95           | "(" write_list "," "id" "=" iter_space ")"
   96           | "string"

   97 compound_statement: branch_statement
   98                   | loop_statement

   99 $@1: ε

  100 branch_statement: "if" "(" expression ")" "then" $@1 body tail

  101 tail: "else" body "endif"
  102     | "endif"

  103 $@2: ε

  104 loop_statement: "do" "id" "=" iter_space $@2 body "enddo"

  105 subprograms: subprograms subprogram
  106            | ε

  107 subprogram: header body "end"

  108 header: type "function" "id" "(" formal_parameters ")"
  109       | "subroutine" "id" "(" formal_parameters ")"
  110       | "subroutine" "id"

  111 formal_parameters: type vars "," formal_parameters
  112                  | error vars "," formal_parameters
  113                  | type error "," formal_parameters
  114                  | type vars error formal_parameters
  115                  | type vars "," error
  116                  | type vars
  117                  | error vars
  118                  | type error


Terminals, with rules where they appear

    "end of file" (0) 0
    error (256) 112 113 114 115 117 118
    "function" (258) 108
    "subroutine" (259) 109 110
    "end" (260) 1 107
    "common" (261) 4
    "int" (262) 7
    "real" (263) 8
    "complex" (264) 9
    "logical" (265) 10
    "char" (266) 11
    "data" (267) 5
    "continue" (268) 53
    "goto" (269) 76 77
    "call" (270) 82
    "read" (271) 83
    "write" (272) 84
    "if" (273) 80 81 100
    "then" (274) 100
    "else" (275) 101
    "endif" (276) 101 102
    "do" (277) 104
    "enddo" (278) 104
    "stop" (279) 55
    "return" (280) 54
    "length" (281) 75
    "id" <strval> (282) 14 15 19 22 23 24 25 26 58 59 77 88 95 104 108 109 110
    "iconst" <intval> (283) 18 36 45
    "rconst" <realval> (284) 37 40
    "lconst" <booleanval> (285) 38
    "cconst" <charval> (286) 39
    "string" <strval> (287) 31 57 96
    ".OR." (288) 62
    ".AND." (289) 63
    ".NOT." (290) 69
    ".GT. or.GE. or .LT. or .LE. or .EQ. or .NE." (291) 64
    "+ or -" (292) 32 65 70
    "*" (293) 66
    "/" (294) 22 27 67
    "**" (295) 68
    "(" (296) 14 58 73 75 77 80 81 88 95 100 108 109
    ")" (297) 14 58 73 75 77 80 81 88 95 100 108 109
    "," (298) 12 16 23 25 28 60 77 78 80 85 88 89 90 92 95 111 112 113 115
    "=" (299) 56 57 88 95 104
    "[" (300) 40 74
    "]" (301) 40 74
    ":" (302) 40 74


